{
  "name": "tgcrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create tgcrm-db",
    "db:migrate:local": "wrangler d1 migrations apply tgcrm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tgcrm-db --remote",
    "webhook": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.129.0"
  }
}