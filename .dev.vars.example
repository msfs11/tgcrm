# Copy to .dev.vars for local development (wrangler dev). Never commit .dev.vars.
# Production values are stored as Cloudflare Worker secrets:
#   npx wrangler secret put BOT_TOKEN
#   npx wrangler secret put TELEGRAM_WEBHOOK_SECRET
#   npx wrangler secret put ADMIN_GROUP_ID
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
ADMIN_GROUP_ID=-1001234567890
ADMIN_USER_ID=123456789